# Copy to /etc/osu-score-api/env and run: chmod 600 /etc/osu-score-api/env
# Placeholders only. Never commit the real file or put secrets in the repo.
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=replace-with-your-secret
CACHE_PATH=/var/lib/osu-score-api/cache
STATS_PATH=/var/lib/osu-score-api/stats/usage.json
NEGATIVE_CACHE_TTL=60
CACHE_TIMEOUT=60
CACHE_RETENTION=15552000
RATE_LIMIT_WINDOW=60
RATE_LIMIT_PER_IP=20
RATE_LIMIT_PER_PLAYER=10
OSU_REQUESTS_PER_MINUTE=60
CORS_ORIGINS=["https://scores.example.com"]
# English readable application logs. Use json for log collectors.
LOG_FORMAT=text
# DEBUG adds HTTP starts, pacing and artwork cache/queue details.
LOG_LEVEL=INFO
