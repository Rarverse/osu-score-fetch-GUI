# Copy to /etc/osu-score-api/env and run: chmod 600 /etc/osu-score-api/env
# Placeholders only. Never commit the real file or put secrets in the repo.
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=replace-with-your-secret
CACHE_PATH=/var/lib/osu-score-api/cache
STATS_PATH=/var/lib/osu-score-api/stats/usage.json
NEGATIVE_CACHE_TTL=60
CACHE_TIMEOUT=180
CACHE_RETENTION=15552000
RATE_LIMIT_WINDOW=60
RATE_LIMIT_PER_IP=20
RATE_LIMIT_PER_PLAYER=10
OSU_REQUESTS_PER_MINUTE=60
CORS_ORIGINS=["https://scores.example.com"]
# English readable application logs. Use json for log collectors.
LOG_FORMAT=text
# DEBUG adds HTTP starts, pacing and artwork cache/queue details.
LOG_LEVEL=INFO

# Optional administrator dashboard. See docs/admin.md in the repository.
# ADMIN_ENABLED=true
# ADMIN_PUBLIC_ORIGIN=https://scores.example.com
# DATABASE_URL=postgresql+psycopg://raru:replace-with-db-password@postgres:5432/raru
# OIDC_ISSUER=https://auth.example.com/application/o/raru-admin/
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# OIDC_REDIRECT_URI=https://scores.example.com/api/admin/auth/callback
# OIDC_SCOPES=openid profile email
# ADMIN_ROLE_CLAIM=groups
# ADMIN_REQUIRED_ROLE=raru-admin
# ADMIN_REQUIRED_AMR=pwd,mfa
# AUDIT_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key
# AUDIT_LOOKUP_KEY=replace-with-a-different-urlsafe-base64-32-byte-key
# LOKI_URL=http://loki:3100
# LOKI_TENANT_ID=raru-production
# PROMETHEUS_URL=http://prometheus:9090
