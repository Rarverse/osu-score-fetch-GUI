# TLS terminates here. The score site is plain HTTP on loopback.
# SafeLine (雷池) does this job on the real server; this file is the same shape
# for a host Nginx. compose.yaml publishes no host HTTPS port unless
# COMPOSE_PROFILES=direct:
#
#   CADDY_MODE=proxy
#   BIND_ADDR=127.0.0.1
#   HTTP_PORT=8080
#
# Forward `/` unchanged. $proxy_add_x_forwarded_for keeps a client-supplied
# X-Forwarded-For and appends the address Nginx actually saw. Caddy trusts
# only the docker bridge gateway, then walks that list from the right, so a
# spoofed address to the left is not the visitor IP.

upstream osu_score_web {
    server 127.0.0.1:8080;
}

server {
    listen 80;
    listen [::]:80;
    server_name scores.rarverse.com;
    return 301 https://scores.rarverse.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name scores.rarverse.com;

    ssl_certificate     /etc/ssl/scores.rarverse.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/scores.rarverse.com/privkey.pem;

    location / {
        proxy_pass http://osu_score_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
