# TLS terminates here. The score site is plain HTTP on loopback.
#
# /opt/osu-score-api/.env.deploy:
#   CADDY_MODE=proxy
#   BIND_ADDR=127.0.0.1
#   HTTP_PORT=8080
#   HTTPS_PORT=8443
#
# HTTPS_PORT is a placeholder. compose.yaml always publishes container port
# 443, and proxy mode does not listen on it. Do not set HTTPS_PORT=443 while
# this server block owns host port 443.
#
# Forward `/` and keep the forwarding headers. The inner Caddy routes
# /api and /health; do not strip them here.

upstream osu_score_web {
    server 127.0.0.1:8080;
}

server {
    listen 80;
    listen [::]:80;
    server_name scores.rarverse.com;
    return 301 https://scores.rarverse.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name scores.rarverse.com;

    ssl_certificate     /etc/ssl/scores.rarverse.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/scores.rarverse.com/privkey.pem;

    location / {
        proxy_pass http://osu_score_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
