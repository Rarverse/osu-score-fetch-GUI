# Copy to /opt/osu-score-api/.env.deploy and edit.
# The deploy job overwrites compose.yaml and Caddyfile, and only replaces the
# IMAGE_TAG line in this file. Everything else survives only if it is written here.
#
# This server: SafeLine (雷池) already owns host 80/443 and terminates TLS.
# Caddy listens on loopback only. SafeLine's upstream is http://127.0.0.1:8080.
# No certificate directory. Public site is https://scores.rarverse.com (no port).
# Do not set COMPOSE_PROFILES=direct here. That profile publishes HTTPS_PORT.
#
# Used by:
#   docker compose --env-file /opt/osu-score-api/.env.deploy -f compose.yaml up -d
# No osu! secrets here. Those live in /etc/osu-score-api/env.

IMAGE_TAG=local
CADDY_MODE=proxy
BIND_ADDR=127.0.0.1
HTTP_PORT=8080

SITE_DOMAIN=scores.rarverse.com

# Docker network for this project. Caddy sees SafeLine as the gateway address
# because the host connects to the published port. The API trusts only the
# web container, not the gateway and not the public client.
COMPOSE_SUBNET=172.31.210.0/24
COMPOSE_GATEWAY=172.31.210.1
WEB_IPV4=172.31.210.10
TRUSTED_PROXIES=127.0.0.1 172.31.210.1
FORWARDED_ALLOW_IPS=172.31.210.10

# Local `docker compose build` only. The GitHub deploy builds the web image
# with repository variable SITE_URL. For this server that variable is the
# public origin with no port:
#   https://scores.rarverse.com
# Changing it requires a new web image (a new IMAGE_TAG), not only this line.
VITE_SITE_URL=https://scores.rarverse.com

# --- Direct TLS, no SafeLine. Caddy presents your own certificate. ---
# Replace the proxy block above with:
#
# COMPOSE_PROFILES=direct
# CADDY_MODE=direct
# BIND_ADDR=0.0.0.0
# HTTP_PORT=1221
# HTTPS_PORT=4463
# PUBLIC_HTTPS_PORT=4463
# TLS_CERT_DIR=/opt/osu-score-api/certs
# SITE_DOMAIN=scores.rarverse.com
# VITE_SITE_URL=https://scores.rarverse.com:4463
#
# COMPOSE_PROFILES=direct starts https-publish, which is what binds HTTPS_PORT.
# Leave COMPOSE_PROFILES unset, or empty, when SafeLine owns host 443.
