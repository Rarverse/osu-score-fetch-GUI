# Copy to /opt/osu-score-api/.env.deploy and edit.
# The deploy job overwrites compose.yaml and Caddyfile, and only replaces the
# IMAGE_TAG line in this file. Ports, domain, and the certificate directory
# survive only if they are written here.
#
# Used by:
#   docker compose --env-file /opt/osu-score-api/.env.deploy -f compose.yaml up -d
# No osu! secrets here. Those live in /etc/osu-score-api/env.

IMAGE_TAG=local
CADDY_MODE=direct
BIND_ADDR=0.0.0.0

# Host ports. Compose defaults are 80 and 443; this server publishes 1221 and 4463.
# Container ports stay 80 and 443.
HTTP_PORT=1221
HTTPS_PORT=4463

# Port browsers should use. Usually the same as HTTPS_PORT.
# 443 is omitted from the redirect URL. Set this explicitly when HTTPS_PORT
# is not the port users type (another NAT hop in front).
PUBLIC_HTTPS_PORT=4463

SITE_DOMAIN=scores.rarverse.com
TLS_CERT_DIR=/opt/osu-score-api/certs

# Local `docker compose build` only. The GitHub deploy builds the web image
# with the repository variable SITE_URL, not this line. That variable must be
# the public origin, including a non-443 port:
#   https://scores.rarverse.com:4463
VITE_SITE_URL=https://scores.rarverse.com:4463

# --- Host already runs Nginx or Caddy on 80/443 ---
# Comment out the direct block above (ports, PUBLIC_HTTPS_PORT, TLS_CERT_DIR
# can stay) and use:
#
# CADDY_MODE=proxy
# BIND_ADDR=127.0.0.1
# HTTP_PORT=8080
# HTTPS_PORT=8443
#
# Caddy then serves plain HTTP on container port 80 and does not read
# /certs. Compose still publishes container port 443; nothing listens there
# in proxy mode. Keep HTTPS_PORT off the front proxy's 443 (8443 on loopback
# is only a placeholder). Point Nginx/Caddy at 127.0.0.1:8080.
# See deploy/nginx.conf.example.
