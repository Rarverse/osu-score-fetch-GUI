# Plain HTTP only. HTTPS is the reverse proxy's job (SafeLine, Nginx, or
# another Caddy on the host). This file does not load certificates and does
# not redirect to HTTPS.
#
# The peer is trusted when it is in TRUSTED_PROXIES (the docker bridge
# gateway, and loopback). X-Forwarded-For is walked from the right, and only
# that resolved address is sent to the API.
{
	auto_https off
	servers :80 {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1 172.31.210.1}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@static path *.svg *.png *.ico *.webp *.woff2
	header @static Cache-Control "public, max-age=86400"

	@html path / /index.html *.html
	header @html Cache-Control "no-cache"

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {http.vars.client_ip}
			header_up X-Real-IP {http.vars.client_ip}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}

	handle /health {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {http.vars.client_ip}
			header_up X-Real-IP {http.vars.client_ip}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
