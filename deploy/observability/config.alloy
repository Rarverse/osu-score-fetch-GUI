discovery.docker "raru" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "raru" {
  targets = discovery.docker.raru.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "osu-score-api"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    target_label = "environment"
    replacement  = "production"
  }
}

loki.source.docker "raru" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.raru.output
  forward_to = [loki.write.raru.receiver]
}

loki.write "raru" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
    headers = {
      "X-Scope-OrgID" = "raru-production",
    }
  }
}
