# Copy to .env in this directory (repository root, or DEPLOY_DIR on the server):
#   cp .env.example .env
# Compose reads .env automatically. Do not pass --env-file.
# The deploy job rewrites only the IMAGE_TAG line. Other lines stay.
# Do not commit .env. Do not put osu! client id/secret here, and do not use a
# VITE_ prefix for secrets. Those credentials belong in /etc/osu-score-api/env
# (mode 600). See deploy/env.example.
#
# HTTPS is the reverse proxy's job. This stack listens on loopback HTTP only.
# SafeLine (雷池) or Nginx owns host 80/443. Upstream is http://127.0.0.1:8080.
# Public site is https://scores.rarverse.com (no port). Values below are unquoted.
#
# If an older .env.deploy still has COMPOSE_PROFILES, CADDY_MODE, HTTPS_PORT,
# PUBLIC_HTTPS_PORT, TLS_CERT_DIR, or SITE_DOMAIN, delete those lines after
# moving the file to .env. They are not read anymore.

# GHCR image tag. Omitted or empty falls back to latest inside compose.yaml.
# The deploy workflow replaces this line with the full git sha.
IMAGE_TAG=latest

BIND_ADDR=127.0.0.1
HTTP_PORT=8080

# Docker network for this project. Caddy sees the reverse proxy as the gateway
# address because the host connects to the published port. The API trusts only
# the web container, not the gateway and not the public client.
# WEB_IPV4 must sit inside COMPOSE_SUBNET. FORWARDED_ALLOW_IPS must be that
# same web address.
COMPOSE_SUBNET=172.31.210.0/24
COMPOSE_GATEWAY=172.31.210.1
WEB_IPV4=172.31.210.10
TRUSTED_PROXIES=127.0.0.1 172.31.210.1
FORWARDED_ALLOW_IPS=172.31.210.10

# Optional host path Compose reads for osu! credentials.
# OSU_ENV_FILE=/etc/osu-score-api/env

# Local `docker compose build` only. Passed as the web image build arg so
# og:image and og:url are absolute. The GitHub deploy builds the web image
# with repository variable SITE_URL instead. For this server that origin is
# https://scores.rarverse.com (no port). Changing it requires a new web image,
# not only this line. Pulling a prebuilt image does not apply this value.
VITE_SITE_URL=https://scores.rarverse.com
