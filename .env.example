# Optional: copy to .env, edit, then chmod 600 .env. Never commit .env.
# Without server credentials the site starts; visitors may use their own.
# OSU_CLIENT_ID=12345
# OSU_CLIENT_SECRET=your-real-secret

# English readable logs; use json for log collectors, DEBUG for detailed diagnostics.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Reuse scores for 3 minutes. Artwork is cached indefinitely.
CACHE_TIMEOUT=180

BIND_ADDR=127.0.0.1
HTTP_PORT=8080

# Public origin for sharing metadata. Build again after changing this value.
VITE_SITE_URL=https://scores.example.com

# Optional: reuse an existing server credential file instead of this .env.
# API_ENV_FILE=/etc/osu-score-api/env

# Change together only if the default subnet conflicts with another Docker network.
COMPOSE_SUBNET=172.31.210.0/24
COMPOSE_GATEWAY=172.31.210.1
WEB_IPV4=172.31.210.10
TRUSTED_PROXIES=127.0.0.1 172.31.210.1

# Optional second and third credential pairs; configured pairs rotate per lookup.
# OSU_CLIENT_ID_2=23456
# OSU_CLIENT_SECRET_2=replace-with-second-secret
# OSU_CLIENT_ID_3=34567
# OSU_CLIENT_SECRET_3=replace-with-third-secret

# Optional administrator dashboard. Keep disabled until every value below is ready.
# Full setup: docs/admin.md
# ADMIN_ENABLED=true
# ADMIN_PUBLIC_ORIGIN=https://scores.example.com
# DATABASE_URL=postgresql+psycopg://raru:replace-with-db-password@postgres:5432/raru
# POSTGRES_DB=raru
# POSTGRES_USER=raru
# POSTGRES_PASSWORD=replace-with-a-long-random-password
# OIDC_ISSUER=https://auth.example.com/application/o/raru-admin/
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# OIDC_REDIRECT_URI=https://scores.example.com/api/admin/auth/callback
# OIDC_SCOPES=openid profile email
# ADMIN_ROLE_CLAIM=groups
# ADMIN_REQUIRED_ROLE=raru-admin
# ADMIN_REQUIRED_AMR=pwd,mfa
# AUDIT_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key
# AUDIT_LOOKUP_KEY=replace-with-a-different-urlsafe-base64-32-byte-key
# LOKI_URL=http://loki:3100
# LOKI_TENANT_ID=raru-production
# PROMETHEUS_URL=http://prometheus:9090
