# Create an OAuth application at https://osu.ppy.sh/home/account/edit
# Uncomment and fill in both values to enable real queries.
# OSU_CLIENT_ID=12345
# OSU_CLIENT_SECRET=replace-with-your-secret
# English human-readable logs by default; use json for log collectors.
LOG_FORMAT=text
# DEBUG adds HTTP request starts, pacing and artwork cache/queue details.
LOG_LEVEL=INFO
# Refresh on query; coalesce identical requests for 3 minutes.
CACHE_TIMEOUT=180
# Retain inactive score cache files for 180 days; artwork is kept indefinitely.
CACHE_RETENTION=15552000
CACHE_PATH=.cache
# Daily anonymous usage aggregate. Relative paths use the process working directory.
STATS_PATH=data/cache/usage.json
# How long a missing player stays cached. Repeat lookups return the same 404.
NEGATIVE_CACHE_TTL=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_PER_IP=20
RATE_LIMIT_PER_PLAYER=10
# Official v2 guidance: at most 60 HTTP requests/minute, spaced at least 1 second.
# Can be lowered to 3–59; values above 60 are rejected at startup.
OSU_REQUESTS_PER_MINUTE=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional second and third credential pairs; configured pairs rotate per lookup.
# OSU_CLIENT_ID_2=23456
# OSU_CLIENT_SECRET_2=replace-with-second-secret
# OSU_CLIENT_ID_3=34567
# OSU_CLIENT_SECRET_3=replace-with-third-secret

# Optional administrator dashboard. See ../../docs/admin.md before enabling it.
# ADMIN_ENABLED=true
# ADMIN_PUBLIC_ORIGIN=http://localhost:5173
# ADMIN_SECURE_COOKIES=false
# DATABASE_URL=postgresql+psycopg://raru:replace-with-db-password@localhost:5432/raru
# OIDC_ISSUER=https://auth.example.com/application/o/raru-admin/
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# OIDC_REDIRECT_URI=http://localhost:5173/api/admin/auth/callback
# OIDC_SCOPES=openid profile email
# ADMIN_ROLE_CLAIM=groups
# ADMIN_REQUIRED_ROLE=raru-admin
# ADMIN_REQUIRED_AMR=pwd,mfa
# AUDIT_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key
# AUDIT_LOOKUP_KEY=replace-with-a-different-urlsafe-base64-32-byte-key
# LOKI_URL=http://localhost:3100
# LOKI_TENANT_ID=raru-production
# PROMETHEUS_URL=http://localhost:9090
